# Copy this file to .env and fill in the values. Never commit .env.

# Neon "Workout Log" — pooled connection string (host contains "-pooler") for the app
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST-pooler/neondb?sslmode=require
# Neon direct connection string (no "-pooler") for Alembic migrations
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASS@HOST/neondb?sslmode=require

GEMINI_API_KEY=
# gemini-2.5-flash is closed to new API keys. gemini-3.8-flash and gemini-flash-latest
# share one free-tier quota (20 requests/day) that exhausts fast; the -flash-lite
# models use a separate, less-restricted free-tier quota.
GEMINI_MODEL=gemini-3.1-flash-lite

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google OAuth client ID (only needed for Google sign-in)
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional
TOKEN_MAX_AGE_SECONDS=604800
MIN_AGE=16
